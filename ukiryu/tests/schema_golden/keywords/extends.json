  "cases": [
    {
      "scheme": "urn",
      "contents": null,
      "expect": {
        "error": {
          "class": "Errno::ENOENT",
          "message": "No such file or directory @ rb_sysopen - ${RESOURCE}"
        }
      }
    },
    {
      "scheme": "urn",
      "contents": "{\"type\":\"integer\"}",
      "expect": {
        "ok": [
          "The property '#/' was not a valid schema in schema urn:root"
        ]
      }
    },
    {
      "scheme": "urn",
      "contents": "{}",
      "expect": {
        "ok": [
          "The property '#/' was not a valid schema in schema urn:root"
        ]
      }
    },
    {
      "scheme": "urn",
      "contents": "false",
      "expect": {
        "error": {
          "class": "NoMethodError",
          "message": "undefined method '[]' for false"
        }
      }
    },
    {
      "scheme": "urn",
      "contents": "[]",
      "expect": {
        "error": {
          "class": "TypeError",
          "message": "no implicit conversion of String into Integer"
        }
      }
    },
    {
      "scheme": "urn",
      "contents": "1",
      "expect": {
        "error": {
          "class": "TypeError",
          "message": "no implicit conversion of String into Integer"
        }
      }
    },
    {
      "scheme": "urn",
      "contents": "invalid",
      "expect": {
        "error": {
          "class": "JSON::Schema::JsonParseError",
          "message": "unexpected character: 'invalid' at line 1 column 1"
        }
      }
    },
