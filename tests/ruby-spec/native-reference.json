      "yaml": "b: 1\na: 2\nc: {z: 1, y: 2}\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "b"
              },
              {
                "$int": "1"
              }
            ],
            [
              {
                "$sym": "a"
              },
              {
                "$int": "2"
              }
            ],
            [
              {
                "$sym": "c"
              },
              {
                "$hash": [
                  [
                    {
                      "$sym": "z"
                    },
                    {
                      "$int": "1"
                    }
                  ],
                  [
                    {
                      "$sym": "y"
                    },
                    {
                      "$int": "2"
                    }
                  ]
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "bigint",
      "yaml": "v: 123456789012345678901234567890\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$int": "123456789012345678901234567890"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "negative-bigint",
      "yaml": "v: -123456789012345678901234567890\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$int": "-123456789012345678901234567890"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "i64-edges",
      "yaml": "v: [9223372036854775807, -9223372036854775808, 18446744073709551615]\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$array": [
                  {
                    "$int": "9223372036854775807"
                  },
                  {
                    "$int": "-9223372036854775808"
                  },
                  {
                    "$int": "18446744073709551615"
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "floats",
      "yaml": "v: [1.0, 2.5, -0.0, 1e300]\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$array": [
                  {
                    "$float": "1.0"
                  },
                  {
                    "$float": "2.5"
                  },
                  {
                    "$float": "-0.0"
                  },
                  {
                    "$str": "1e300",
                    "encoding": "UTF-8"
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "nil-false",
      "yaml": "v: [null, ~, false, true]\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$array": [
                  null,
                  null,
                  false,
                  true
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "non-string-keys",
      "yaml": "1: a\ntrue: b\n2.5: c\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "1"
              },
              {
                "$str": "a",
                "encoding": "UTF-8"
              }
            ],
            [
              {
                "$sym": "true"
              },
              {
                "$str": "b",
                "encoding": "UTF-8"
              }
            ],
            [
              {
                "$sym": "2.5"
              },
              {
                "$str": "c",
                "encoding": "UTF-8"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "unicode",
      "yaml": "v: \"Ω\\0z\"\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$str": "Ω\u0000z",
                "encoding": "UTF-8"
              }
            ]
          ]
        }
      }
    },
    {
      "id": "nested",
      "yaml": "v:\n  - a: 1\n    b: [x, {c: d}]\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "v"
              },
              {
                "$array": [
                  {
                    "$hash": [
                      [
                        {
                          "$sym": "a"
                        },
                        {
                          "$int": "1"
                        }
                      ],
                      [
                        {
                          "$sym": "b"
                        },
                        {
                          "$array": [
                            {
                              "$str": "x",
                              "encoding": "UTF-8"
                            },
                            {
                              "$hash": [
                                [
                                  {
                                    "$sym": "c"
                                  },
                                  {
                                    "$str": "d",
                                    "encoding": "UTF-8"
                                  }
                                ]
                              ]
                            }
                          ]
                        }
                      ]
                    ]
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "anchor-alias",
      "yaml": "a: &x [1, 2]\nb: *x\n",
      "expect": {
        "ok": {
          "$hash": [
            [
              {
                "$sym": "a"
              },
              {
                "$array": [
                  {
                    "$int": "1"
                  },
                  {
                    "$int": "2"
                  }
                ]
              }
            ],
            [
              {
                "$sym": "b"
              },
              {
                "$array": [
                  {
                    "$int": "1"
                  },
                  {
                    "$int": "2"
                  }
                ]
              }
            ]
          ]
        }
      }
    },
    {
      "id": "empty",
      "yaml": "",
      "expect": {
        "ok": null
      }
    },
    {
      "id": "null-doc",
      "yaml": "~\n",
      "expect": {
        "ok": null
      }
    },
